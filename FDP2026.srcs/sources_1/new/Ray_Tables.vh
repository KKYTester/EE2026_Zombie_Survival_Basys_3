function signed [8:0] sine_step;
    input [9:0] phase;
    reg [8:0] folded;
    reg signed [8:0] magnitude;
    begin
        folded = phase[8] ? (9'd256 - {1'b0,phase[7:0]}) : {1'b0,phase[7:0]};
        magnitude = $signed({1'b0,quarter_sine(folded)});
        sine_step = phase[9] ? -magnitude : magnitude;
    end
endfunction
